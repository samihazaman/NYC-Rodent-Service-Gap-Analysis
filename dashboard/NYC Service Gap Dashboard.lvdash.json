{
  "datasets": [
    {
      "name": "cc18ba8b",
      "displayName": "zip_service_gap",
      "config": {
        "version": "1.1",
        "source": "workspace.default.zip_service_gap",
        "dimensions": [
          {
            "name": "zip_code",
            "expr": "zip_code",
            "comment": "Five-digit NYC ZIP. Primary key, one row per ZIP."
          },
          {
            "name": "borough",
            "expr": "borough",
            "comment": "Modal borough for this ZIP, from its 311 complaints."
          },
          {
            "name": "complaints_total",
            "expr": "complaints_total",
            "comment": "All 311 rodent complaints in this ZIP (evidence + condition)."
          },
          {
            "name": "complaints_evidence",
            "expr": "complaints_evidence",
            "comment": "Complaints where a rodent or its signs were reported seen."
          },
          {
            "name": "complaints_condition",
            "expr": "complaints_condition",
            "comment": "Complaints about conditions attracting rodents; no rodent reported seen."
          },
          {
            "name": "complaints_commercial",
            "expr": "complaints_commercial",
            "comment": "311 rodent complaints at commercial buildings. Shares a population with restaurant inspection data."
          },
          {
            "name": "complaints_residential",
            "expr": "complaints_residential",
            "comment": "311 rodent complaints at non-commercial locations. No restaurant denominator."
          },
          {
            "name": "restaurants_inspected",
            "expr": "restaurants_inspected",
            "comment": "Distinct restaurants inspected in this ZIP."
          },
          {
            "name": "restaurants_rodent_evidence",
            "expr": "restaurants_rodent_evidence",
            "comment": "Distinct restaurants cited 04K or 04L, inspector-verified rodent evidence."
          },
          {
            "name": "restaurants_harborage",
            "expr": "restaurants_harborage",
            "comment": "Distinct restaurants cited 08A, conditions conducive to rodents."
          },
          {
            "name": "verified_rodent_rate",
            "expr": "verified_rodent_rate",
            "comment": "restaurants_rodent_evidence / restaurants_inspected. Best proxy for real rodent conditions."
          },
          {
            "name": "commercial_complaints_per_100_restaurants",
            "expr": "commercial_complaints_per_100_restaurants",
            "comment": "Commercial 311 complaints per 100 inspected restaurants. Valid ratio: same population on both sides."
          },
          {
            "name": "pct_closed",
            "expr": "pct_closed",
            "comment": "Share of this ZIP's complaints with a closed_ts."
          },
          {
            "name": "median_hours_to_close",
            "expr": "median_hours_to_close",
            "comment": "Median hours from filing to closure among closed complaints."
          },
          {
            "name": "pct_closed_under_1hr",
            "expr": "pct_closed_under_1hr",
            "comment": "Share of complaints closed within one hour of filing."
          },
          {
            "name": "z_verified",
            "expr": "z_verified",
            "comment": "verified_rodent_rate as a z-score across ZIPs with sufficient data."
          },
          {
            "name": "z_reporting_commercial",
            "expr": "z_reporting_commercial",
            "comment": "commercial_complaints_per_100_restaurants as a z-score across ZIPs with sufficient data."
          },
          {
            "name": "restaurant_service_gap_index",
            "expr": "restaurant_service_gap_index",
            "comment": "z_verified minus z_reporting_commercial. High means inspectors verify rodent conditions but commercial reporting is low."
          },
          {
            "name": "residential_complaint_rank_citywide",
            "expr": "residential_complaint_rank_citywide",
            "comment": "Citywide rank of residential complaint volume. Rank 1 is most residential complaints."
          },
          {
            "name": "data_sufficiency",
            "expr": "data_sufficiency",
            "comment": "sufficient, thin, or insufficient. Index withheld for insufficient ZIPs."
          },
          {
            "name": "zip_note",
            "expr": "zip_note",
            "comment": "Plain-language caveat for this ZIP, meant for display."
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count",
            "comment": "Total number of ZIP codes"
          }
        ]
      }
    },
    {
      "name": "zip_metrics_long",
      "displayName": "ZIP Metrics (Long Format)",
      "config": {
        "version": "1.1",
        "source": "SELECT zip_code, '311 Complaints' AS category, 'Rodent Evidence' AS metric_name, CAST(complaints_evidence AS DOUBLE) AS value FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, '311 Complaints', 'Condition Reports', CAST(complaints_condition AS DOUBLE) FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, '311 Complaints', 'Commercial', CAST(complaints_commercial AS DOUBLE) FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, '311 Complaints', 'Residential', CAST(complaints_residential AS DOUBLE) FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, 'Restaurant Inspections', 'Rodent Evidence', CAST(restaurants_rodent_evidence AS DOUBLE) FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, 'Restaurant Inspections', 'Harborage', CAST(restaurants_harborage AS DOUBLE) FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, 'Z-Scores', 'Verified (z)', CAST(z_verified AS DOUBLE) FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, 'Z-Scores', 'Reporting Commercial (z)', CAST(z_reporting_commercial AS DOUBLE) FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, 'Key Rates', 'Verified Rodent Rate (%)', CAST(verified_rodent_rate AS DOUBLE) * 100 FROM workspace.default.zip_service_gap UNION ALL SELECT zip_code, 'Key Rates', 'Commercial Complaints per 100 Restaurants', CAST(commercial_complaints_per_100_restaurants AS DOUBLE) FROM workspace.default.zip_service_gap\n",
        "dimensions": [
          {
            "name": "zip_code",
            "expr": "zip_code",
            "comment": "Five-digit NYC ZIP code"
          },
          {
            "name": "category",
            "expr": "category",
            "comment": "Metric category for grouping"
          },
          {
            "name": "metric_name",
            "expr": "metric_name",
            "comment": "Specific metric name within the category"
          }
        ],
        "measures": [
          {
            "name": "total_value",
            "expr": "SUM(value)",
            "displayName": "Value",
            "comment": "Metric value summed across any grouping"
          }
        ]
      }
    }
  ],
